# Copie para .env.local e preencha o que tiver. Tudo é opcional:
# sem nenhuma chave o painel funciona com dados locais (.data/banco.json).

# --- Supabase (banco de ideias, conexões e histórico) ---
# Rode supabase/schema.sql no SQL Editor do projeto antes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude (busca semântica, organizar ideia ditada, conversa) ---
ANTHROPIC_API_KEY=

# --- Transcrição de áudio (Whisper) ---
# Qualquer endpoint compatível com /v1/audio/transcriptions.
# OpenAI: WHISPER_URL=https://api.openai.com/v1/audio/transcriptions + WHISPER_API_KEY
# Local (faster-whisper-server, whisper.cpp server): WHISPER_URL=http://localhost:8000/v1/audio/transcriptions
# Sem isso, o painel usa o reconhecimento de voz do próprio navegador (Chrome/Edge).
WHISPER_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# --- GitHub (importar repositórios como ideias) ---
# Token clássico ou fine-grained com leitura de repositórios e issues.
GITHUB_TOKEN=

# --- Desktop (pasta local com notas .md) ---
# Padrão: o cofre Obsidian onde este app mora (pasta pai) -> 01-Projetos.
IDEIAS_PASTA_LOCAL=
